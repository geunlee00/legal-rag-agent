# 이 파일을 복사해 .env 로 만들고 실제 값을 채우세요.
#   cp .env.example .env

# Django
SECRET_KEY=change-me
DEBUG=True

# PostgreSQL (docker-compose 기본값과 일치)
DB_NAME=legal_rag
DB_USER=rag_user
DB_PASSWORD=rag_pass
DB_HOST=localhost
DB_PORT=5432

# 국가법령정보센터 Open API 인증값(OC)
OC=your_oc_id

# OpenAI API 키
OPENAI_API_KEY=sk-...
