# 이 파일을 복사해 .env 로 만들고 실제 값을 채우세요.
#   cp .env.example .env

# Django
SECRET_KEY=change-me
DEBUG=True
# 배포(EC2) 시: DEBUG=False, ALLOWED_HOSTS에 공인 IP/도메인 (콤마 구분)
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=legal_rag
DB_USER=rag_user
DB_PASSWORD=rag_pass
DB_HOST=localhost
DB_PORT=5432
# 배포(docker-compose.prod) 시: DB_HOST=db  (컨테이너 이름으로 접속)

# 국가법령정보센터 Open API 인증값(OC)
OC=your_oc_id

# OpenAI API 키
OPENAI_API_KEY=sk-...
ALLOWED_HOSTS=