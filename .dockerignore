# 백엔드 이미지에 넣지 않을 것들

# 로컬 가상환경 (컨테이너에서 새로 설치하므로 불필요, 용량 큼)
.venv/

# 프론트엔드: nginx 빌드가 frontend 소스를 써야 하므로 통째 제외 X.
# 무거운 것(node_modules)과 빌드결과(dist)만 제외.
frontend/node_modules/
frontend/dist/

# 비밀값 (이미지에 박으면 안 됨 → 실행 시 env로 주입)
.env

# 파이썬 캐시
__pycache__/
*.pyc

# git / 에디터 / 문서
.git/
.gitignore
.claude/
*.md

# collectstatic 결과물 (컨테이너 안에서 새로 생성)
staticfiles/
